# Android signing key - never commit (keep a private backup elsewhere)
*.p12
*.jks
*.keystore

# Build outputs
build/
deliverables/
*.apk
*.aab
node_modules/
engine/rust/target/

# Editor/OS cruft
.DS_Store
*.swp

# Local build toolchains (installed per README)
tools/android-sdk/
tools/rust-toolchain/

# Desktop (Electron) wrapper build outputs
desktop/node_modules/
desktop/build/
desktop/dist/
*.rpm
tests/perf/.ws2-off/
tests/perf/.ws3-off/
tests/perf/.ws4-off/
tests/perf/.ws5-off/
tests/.engine-parity-off/
tests/perf/.ws6-*/
tests/perf/.ws7-off/
__pycache__/
tests/perf/.variant-*/
tests/.engine-parity-wasm-*/

# WS13 (D6): app/assets is generated by `npm run build:web` (packaging always builds). Only the Rust output
# mesh-core.wasm stays tracked, so a checkout builds without the Rust toolchain.
app/assets/*
!app/assets/mesh-core.wasm

# occt-sidecar-warmup: local warm-up diagnostics (cs/fp timing dumps), never committed
tests/perf/.warm-diag/
